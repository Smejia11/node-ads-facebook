{
  "name": "facebook-ads-caso-uso",
  "version": "1.0.0",
  "description": "Caso de uso de Facebook/Instagram Ads con la Meta Marketing API (campaña → conjunto → creativo → anuncio)",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22.18.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "debug": "node --env-file=.env src/index.ts --keep-on-error",
    "dry-run": "node --env-file-if-exists=.env --permission --allow-fs-read=./ src/index.ts --dry-run",
    "sandbox": "node --env-file=.env --permission  --allow-fs-read=./ src/index.ts",
    "sandbox:base": "node --env-file=.env --permission --allow-fs-read=./ src/index.ts --skip-creative",
    "start": "node --env-file=.env --permission --allow-fs-read=./ src/index.ts",
    "typecheck": "tsc --noEmit",
    "security": "pnpm audit --audit-level=moderate && pnpm audit signatures",
    "check": "pnpm typecheck && pnpm security"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "7.0.2"
  }
}