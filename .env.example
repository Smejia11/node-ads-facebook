# Copia este archivo como .env (ya está en .gitignore) y completa los valores.

# sandbox | production  → en production el script pide confirmación
META_ENV=sandbox
META_API_VERSION=v26.0

# Token de System User con ads_management + pages_read_engagement
META_ACCESS_TOKEN=
# Obligatorio: firma cada llamada con appsecret_proof.
# Activa también "Require App Secret" en la configuración avanzada de la app.
META_APP_SECRET=

META_AD_ACCOUNT_ID=act_1234567890
META_PAGE_ID=1234567890

# Allowlist: el script se niega a operar sobre cuentas que no estén aquí
META_ALLOWED_AD_ACCOUNTS=act_1234567890

LANDING_URL=https://tusitio.com/landing?utm_source=facebook&utm_medium=paid
# Imagen local dentro del proyecto (jpg/png, máx. 30 MB) o URL pública https
IMAGE_PATH=./assets/banner-1080x1080.jpg
# IMAGE_URL=https://tusitio.com/banner.jpg

# Presupuesto diario en la unidad mínima de la moneda de la cuenta
DAILY_BUDGET=20000
# Tope de seguridad: si DAILY_BUDGET lo supera, el script aborta
MAX_DAILY_BUDGET=100000

TARGET_COUNTRIES=CO
AGE_MIN=25
AGE_MAX=60
